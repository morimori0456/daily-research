[Unit]
Description=Run daily Antigravity prompt research
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/orca/workspaces/w/cachalot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/flock -n %h/.local/share/dashboard/daily-research.lock /usr/bin/python3 %h/orca/workspaces/w/cachalot/daily_research/run_daily_research.py
TimeoutStartSec=130min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/orca/workspaces/w/cachalot/daily_research %h/.local/share/dashboard
